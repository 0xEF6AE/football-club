# 로컬 개발은 아무것도 설정하지 않아도 된다 (프로젝트 루트의 local.db 파일 사용).
# 배포(Vercel)에서는 Turso 값을 Vercel 환경변수에 넣는다.
# 같은 두 값을 .env.turso 파일에 넣어 두면 npm run db:push:turso 로 배포 DB에 스키마를 반영할 수 있다.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# 화면에 표시되는 모임 이름
NEXT_PUBLIC_CLUB_NAME=뽀잉 fc

# 사이트 주소. 링크 미리보기 이미지 주소에 쓴다. Vercel에서는 비워 두면 운영 도메인을 자동으로 쓴다.
NEXT_PUBLIC_SITE_URL=

# 관리자 비밀번호. 설정하면 경기·선수·포메이션 등록/수정/삭제와 피드백 삭제에 필요하다.
# 비워 두면(로컬 개발) 누구나 편집할 수 있다. 피드백 작성, 참석 응답, 투표 댓글은 항상 누구나 가능.
# 참석 투표 마감 뒤 명단 수정은 이 값이 설정돼 있을 때 관리자만 할 수 있다.
ADMIN_PASSCODE=
